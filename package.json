{
  "name": "da-tawan-seafood",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "dev:worker": "pnpm --filter @datawan/worker dev",
    "e2e": "pnpm --filter @datawan/worker test:e2e",
    "verify": "pnpm typecheck && pnpm test && pnpm e2e"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
