# =====================================================================
# Da Tawan Seafood — environment variables
# Copy to .env (local), set as Wrangler secrets (worker) and Vercel/Pages env (web).
# NEVER commit real values. Switching team keys -> owner keys = change values only.
# =====================================================================

# ---- Environment ----------------------------------------------------
APP_ENV=dev                      # dev | exhibition | defence | production
TZ_APP=Asia/Bangkok

# ---- LINE Messaging API (one channel per APP_ENV) -------------------
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_OWNER_USER_ID=              # owner LINE userId(s), comma-separated (Uxxx...,Uyyy...) — commands only accepted from these IDs
LINE_LOGIN_CHANNEL_ID=           # LINE Login channel that hosts the LIFF app (for ID token verify)

# ---- LINE push quota guard ------------------------------------------
LINE_PUSH_MONTHLY_LIMIT=300
QUOTA_WARN_RATIO=0.80            # 240 / 300 -> yellow banner, P1 only
QUOTA_SAVER_RATIO=0.95           # 285 / 300 -> halt all pushes until the 1st
MAX_PUSH_PER_ORDER=1
LIFF_PRESENCE_SECONDS=60

# ---- LIFF / web (public) --------------------------------------------
NEXT_PUBLIC_LIFF_ID=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
CORS_ALLOWED_ORIGINS=http://localhost:3000 # worker: comma-separated browser origins allowed to call /api/* (dashboard + LIFF web URL per env)
NEXT_PUBLIC_USE_MOCKS=false      # true = apps/web runs entirely against src/mocks, no Worker/Supabase/LINE needed
LIFF_DEV_BYPASS=false            # worker: honour x-liff-dev-user header INSTEAD of a real LIFF ID token — only takes effect when APP_ENV=dev (apps/worker/src/auth/liff.ts)
NEXT_PUBLIC_LIFF_DEV_BYPASS=false # web: skip real LIFF login, use a localStorage mock line_user_id + send x-liff-dev-user

# ---- Supabase ---------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=               # worker: verifies owner Supabase access tokens (auth/owner.ts); same project as NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=       # worker only, never in the browser
OWNER_AUTH_USER_ID=              # Supabase auth.users id of the owner (recorded as paid_confirmed_by for LINE commands; dashboard uses the REST-authenticated owner id instead)
STORAGE_RETENTION_DAYS=60

# ---- Gemini ------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=                    # current Flash model id, e.g. from Google AI Studio; never hardcode
GEMINI_TIER=paid                 # paid (team, until defence) | free (owner, after handover)
GEMINI_RPM_LIMIT=10              # set to the key's real limit
GEMINI_RPD_LIMIT=250
GEMINI_SLIP_MODE=paid            # paid | manual | redacted   (see CLAUDE.md D1)
GEMINI_SLIP_API_KEY=             # only used when GEMINI_SLIP_MODE=paid
USE_MOCK_AI=true                 # true = deterministic mock AI (no network/cost); false = Gemini (packages/ai/src/gemini)

# ---- Payments ----------------------------------------------------------
PROMPTPAY_ID=                    # phone or national ID registered with PromptPay (shop owner's)
PROMPTPAY_RECEIVER_NAME=         # name as printed on slips, for the receiver check
PAYMENT_EXPIRY_MINUTES=45
OWNER_REMINDER_MINUTES=15
ABANDON_HOURS=24
# Max orders the every-minute timers act on per run (Workers Free: 50 subrequests/run; ~6 each)
CRON_MAX_ACTIONS_PER_RUN=6
RECENT_ORDER_STATUS_HOURS=24      # after delivery, chat messages still get that order's status + tracking card (free reply) for this long
DEFAULT_MARKUP=0.25
OWNER_POLITENESS=ค่ะ              # ค่ะ | ครับ — particle used in AI-drafted owner messages
LIFF_ID=                         # same as NEXT_PUBLIC_LIFF_ID (worker builds LIFF links)

# ---- Owner Web Push (VAPID) -------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team-highlow@example.com

# ---- Maps -------------------------------------------------------------
NEXT_PUBLIC_LONGDO_MAP_API_KEY=
GEOCODER_FALLBACK=osm            # osm (Nominatim, respect 1 req/s) | none

# ---- Eval ---------------------------------------------------------------
EVAL_DELAY_MS=4000               # pause between benchmark calls (free-tier RPM)
